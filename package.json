{
  "name": "vue-router-persistent-layouts",
  "version": "0.4.0",
  "description": "Inertia-style persistent layouts for Vue Router",
  "keywords": ["vue", "vue-router", "layouts", "persistent-layouts", "inertia"],
  "license": "MIT",
  "author": {
    "name": "Carl Olsen",
    "email": "unstoppablecarlolsen@gmail.com"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm type-check && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.1.0 || ^5.0.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.30",
    "vue-router": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unstoppablecarl/vue-router-persistent-layouts.git"
  },
  "bugs": {
    "url": "https://github.com/unstoppablecarl/vue-router-persistent-layouts/issues"
  }
}
